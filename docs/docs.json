        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "overview/why-onchain",
              "overview/how-it-works",
              "overview/user-flow",
              "overview/supported",
              "overview/fees-and-limits"
            ]
          },
          {
            "group": "Using Matocard",
            "pages": [
              "guides/create-account",
              "guides/verify-identity",
              "guides/top-up",
              "guides/send-money",
              "guides/cash-out",
              "guides/settle",
              "guides/credit-record"
            ]
          },
          {
            "group": "Project",
            "pages": ["overview/roadmap", "overview/faq"]
          }
        ]
      },
      {
        "tab": "Learn",
        "groups": [
          {
            "group": "Credit",
            "pages": [
              "learn/credit-line",
              "learn/credit-score",
              "learn/collateral-and-yield",
              "learn/defaults"
            ]
          },
          {
            "group": "Money in and out",
            "pages": ["learn/payment-gateway", "learn/card-hold", "learn/fx"]
          },
          {
            "group": "Identity",
            "pages": ["learn/kyc"]
          },
          {
            "group": "Lenders",
            "pages": ["learn/lender-pool"]
          },
          {
            "group": "Trust and security",
            "pages": ["learn/trust-model", "learn/risks", "learn/security"]
          }
