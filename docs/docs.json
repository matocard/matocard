    "light": "/logo/matocard.png",
    "dark": "/logo/matocard-white.png",
    "href": "https://matocard.xyz"
  },
  "navbar": {
    "links": [
      { "label": "GitHub", "href": "https://github.com/matocard/matocard" },
      { "label": "API status", "href": "https://api.matocard.xyz/health" }
    ],
    "primary": { "type": "button", "label": "Open Matocard", "href": "https://matocard.xyz" }
  },
  "navigation": {
    "tabs": [
      {
