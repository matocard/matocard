# Everything the app reads. Every NEXT_PUBLIC_* is inlined into the browser bundle at build time,
# so none of them is a secret and all of them need a rebuild to change. Put local values in
# .env.local (ignored by git).

# Reown (WalletConnect) Cloud project. Public by design. https://dashboard.reown.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional overrides; each falls back to the live default.
# The backend (default https://api.matocard.xyz)
NEXT_PUBLIC_MATOCARD_API_URL=
# Monad testnet RPC (default https://testnet-rpc.monad.xyz), if the public one rate-limits a demo
NEXT_PUBLIC_MONAD_RPC_URL=
# Where cash-outs are signed to (default: the treasury published in issue #71)
NEXT_PUBLIC_TREASURY_ADDRESS=

# NEXT_PUBLIC_E2E is deliberately absent. Setting it to 1 swaps the whole wallet layer for a stub
# that signs without a prompt, which is correct under Playwright and catastrophic anywhere else.
