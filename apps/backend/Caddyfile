# HTTPS in front of the backend. The certificate comes from Let's Encrypt through
# a DNS record Caddy writes with HOSTINGER_API_TOKEN, so no port 80 is needed and
# the VPS's other sites keep 80 and 443.
{$API_DOMAIN} {
	tls {
		dns hostinger {env.HOSTINGER_API_TOKEN}
	}
	encode gzip
	reverse_proxy backend:3000
}
