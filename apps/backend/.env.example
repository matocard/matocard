# docker compose reads this file; `bun run dev` and `bun test` read it too (Bun loads .env)
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
PORT=3000
# for running on the host against the compose database
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5433/matocard

# chain: defaults are Monad testnet and the deployed contracts; for a local
# chain run scripts/local-chain.sh and paste what it prints
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# CREDIT_LINE_ADDRESS=
# AUSD_ADDRESS=
# needs KYC_ROLE and RELAYER_ROLE on the credit line, and holds the treasury's AUSD
RELAYER_PK=
DAILY_CAP_USER_AUSD=1000
DAILY_CAP_GLOBAL_AUSD=20000
# MON for gas per verified user; one draw costs about 0.04 on Monad testnet
DRIP_MON=0.5

# any long random string; changing it changes every identity hash and every card number
IDENTITY_SALT=

# Envio GraphQL, for /me/activity, /verify history and reconciliation
INDEXER_URL=https://indexer.dev.hyperindex.xyz/b5ebb5c/v1/graphql

# Xendit test mode: one Indonesian account collects IDR and pays out IDR. The callback
# token is the verification token on Xendit's webhook settings page
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# only for a second account, if collecting moves to another country (README)
XENDIT_PAYOUT_SECRET_KEY=
XENDIT_PAYOUT_CALLBACK_TOKEN=
# where Xendit and Didit send the user back to; on the VPS https://app.matocard.xyz
APP_URL=http://localhost:3001

# Didit sandbox
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# VPS only: adds the backup service and joins the VPS's shared Caddy (docker-compose.vps.yml)
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
