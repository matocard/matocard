# docker compose reads this file; `bun run dev` and `bun test` read it too (Bun loads .env)
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
PORT=3000
# for running on the host against the compose database
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5433/matocard

# chain: defaults are Monad testnet and the deployed contracts; for a local
# chain run scripts/local-chain.sh and paste what it prints
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# CREDIT_LINE_ADDRESS=
# AUSD_ADDRESS=
# needs KYC_ROLE and RELAYER_ROLE on the credit line, and holds the treasury's AUSD
RELAYER_PK=
DAILY_CAP_USER_AUSD=1000
DAILY_CAP_GLOBAL_AUSD=20000
DRIP_MON=0.1

# any long random string; changing it changes every identity hash
IDENTITY_SALT=

# Envio GraphQL, for /me/activity, /verify history and reconciliation
INDEXER_URL=https://indexer.dev.hyperindex.xyz/895b549/v1/graphql

# Xendit test mode. Collecting MYR and paying out IDR need an account each (country of origin)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_PAYOUT_SECRET_KEY=
XENDIT_PAYOUT_CALLBACK_TOKEN=
# where Xendit and Didit send the user back to
APP_URL=http://localhost:3001

# Didit sandbox
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# VPS only (docker compose --profile vps): the public name Caddy serves over HTTPS
API_DOMAIN=api.matocard.xyz
# Hostinger panel → API: lets Caddy prove the domain through DNS (any port works)
HOSTINGER_API_TOKEN=
# 443 unless another server holds it (on our VPS: 8443)
HTTPS_PORT=443
